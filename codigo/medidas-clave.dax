// ═══════════════════════════════════════════════════════════════════════════
// MEDIDAS CLAVE  ·  DAX
// Proyecto: Cumplimiento de plazos de entrega — Centro de Distribución
//
// El modelo tiene 45 medidas alojadas en la tabla vacía _Medidas, agrupadas
// en carpetas de visualización. Aquí están las que resuelven un problema
// concreto: las demás son variantes de formato y etiquetas de presentación.
//
// El razonamiento de cada una está en el README del repositorio.
// ═══════════════════════════════════════════════════════════════════════════


// ───────────────────────────────────────────────────────────────────────
//  1.  Cumple_SLA   ·  COLUMNA CALCULADA en Dim_OV
//      Emite el juicio de cumplimiento con TRES valores, no dos.
//      Sin la tercera categoría, los 275 pedidos sin fecha de cierre se
//      contarían como cumplidos y el indicador saldría subestimado.
// ───────────────────────────────────────────────────────────────────────

Cumple_SLA =
SWITCH(
    TRUE(),
    ISBLANK( Dim_OV[LeadTime_Hab] ),            "Sin medicion",
    Dim_OV[LeadTime_Hab] <= Dim_OV[SLA_Horas],  "Cumple",
                                                "Incumple"
)


// ───────────────────────────────────────────────────────────────────────
//  2.  El denominador correcto
//      El porcentaje se calcula sobre los pedidos MEDIBLES, nunca sobre
//      el total. Incluir lo que no se puede medir reporta un cumplimiento
//      mejor que el real.
// ───────────────────────────────────────────────────────────────────────

OVs = COUNTROWS( Dim_OV )

OVs Medibles     = CALCULATE( [OVs], Dim_OV[Cumple_SLA] <> "Sin medicion" )
OVs Fuera de SLA = CALCULATE( [OVs], Dim_OV[Cumple_SLA] =  "Incumple" )

% Incumplimiento SLA = DIVIDE( [OVs Fuera de SLA], [OVs Medibles] )

Valor en Riesgo = CALCULATE( SUM( Dim_OV[Valor_OV] ), Dim_OV[Cumple_SLA] = "Incumple" )


// ───────────────────────────────────────────────────────────────────────
//  3.  Mediana, no promedio
//      Los tiempos de atención tienen casos extremos (pedidos que esperan
//      semanas por una compra). El promedio los sigue; la mediana describe
//      el pedido típico, que es lo que la operación puede gestionar.
// ───────────────────────────────────────────────────────────────────────

LeadTime Mediano (h)        = MEDIAN( Dim_OV[LeadTime_Cal] )
LeadTime Habil Mediano (h)  = MEDIAN( Dim_OV[LeadTime_Hab] )


// ───────────────────────────────────────────────────────────────────────
//  4.  % OVs Post 19h   ·   REMOVEFILTERS en numerador Y denominador
//      Responde la consulta original de gerencia. La primera versión daba
//      1,63 % porque CALCULATE sobrescribía el segmentador en el numerador
//      pero no en el denominador: un conflicto de contexto de filtro que
//      NO lanza ningún error. Se detectó moviendo el segmentador y
//      preguntándose por qué cambió lo que cambió.
// ───────────────────────────────────────────────────────────────────────

% OVs Post 19h =
VAR _Nocturnas =
    CALCULATE(
        [OVs],
        REMOVEFILTERS( Dim_OV[Franja_Ingreso] ),
        Dim_OV[Franja_Ingreso] = "6. Nocturno (>19:00)"
    )
VAR _Total =
    CALCULATE( [OVs], REMOVEFILTERS( Dim_OV[Franja_Ingreso] ) )
RETURN
    DIVIDE( _Nocturnas, _Total )


// ───────────────────────────────────────────────────────────────────────
//  5.  Pickings del Dia   ·   USERELATIONSHIP
//      Un solo calendario sirviendo dos fechas distintas. La relación con
//      la fecha de creación del picking está INACTIVA en el modelo y se
//      activa solo dentro de esta medida. La alternativa era un segundo
//      calendario, que habría duplicado los segmentadores.
// ───────────────────────────────────────────────────────────────────────

Pickings del Dia =
CALCULATE(
    [Pickings],
    USERELATIONSHIP( Dim_Calendario[Date], Dim_Picking[Fecha_Creacion_Picking] )
)


// ───────────────────────────────────────────────────────────────────────
//  6.  % Incumplimiento por Accion   ·   CROSSFILTER
//      El hallazgo dominante del proyecto. El filtro nace en una tabla de
//      hechos (F_Linea_OV, donde vive la acción de abastecimiento) y debe
//      llegar a una dimensión (Dim_OV, donde vive el cumplimiento).
//      Sin CROSSFILTER el filtro no propaga y las tres categorías muestran
//      el mismo valor — otro error que no da mensaje.
// ───────────────────────────────────────────────────────────────────────

% Incumplimiento por Accion =
CALCULATE(
    [% Incumplimiento SLA],
    CROSSFILTER( Dim_OV[Nro_Doc], F_Linea_OV[Nro_Doc], BOTH )
)

LeadTime por Picking =
CALCULATE(
    [LeadTime Habil Mediano (h)],
    CROSSFILTER( Dim_OV[Nro_Doc], F_Linea_Picking[Nro_Doc], BOTH )
)


// ───────────────────────────────────────────────────────────────────────
//  7.  Var Incumplimiento MoM   ·   la guarda del período
//      DATEADD desplaza TODO el rango seleccionado, así que con los siete
//      meses activos la variación salía 0,00 pp. La guarda obliga a que
//      haya exactamente un mes seleccionado; si no, la medida se calla
//      en vez de mentir.
// ───────────────────────────────────────────────────────────────────────

% Incumplimiento Mes Anterior =
CALCULATE(
    [% Incumplimiento SLA],
    DATEADD( Dim_Calendario[Date], -1, MONTH )
)

Var Incumplimiento MoM =
VAR _Meses  = DISTINCTCOUNT( Dim_Calendario[Anio_Mes] )
VAR _Actual = [% Incumplimiento SLA]
VAR _Previo = [% Incumplimiento Mes Anterior]
RETURN
    IF(
        _Meses <> 1 || ISBLANK( _Previo ) || ISBLANK( _Actual ),
        BLANK(),
        _Actual - _Previo
    )


// ───────────────────────────────────────────────────────────────────────
//  8.  Las medidas del tooltip   ·   doble CROSSFILTER
//      La página emergente responde a los segmentadores de CUALQUIERA de
//      las dos tablas de hechos, así que necesita las dos relaciones
//      abiertas en el mismo CALCULATE. Con una sola, los valores se
//      repetían al pasar el cursor por el panel de complejidad.
// ───────────────────────────────────────────────────────────────────────

TT Pedidos =
CALCULATE(
    [OVs],
    CROSSFILTER( Dim_OV[Nro_Doc], F_Linea_OV[Nro_Doc],      BOTH ),
    CROSSFILTER( Dim_OV[Nro_Doc], F_Linea_Picking[Nro_Doc], BOTH )
)

// Los tres estados tienen que sumar el total. La cuarta tarjeta existe
// porque "A tiempo" + "Fuera de plazo" NO daba "Pedidos": faltaban los
// 275 sin medición. No era un error de cálculo, era una categoría oculta.
TT Sin Medir = [TT Pedidos] - [TT Pedidos Dentro] - [TT Pedidos Fuera]


// ───────────────────────────────────────────────────────────────────────
//  9.  TT Titulo   ·   SELECTEDVALUE en cascada
//      El título del tooltip dice de qué está hablando, cualquiera sea la
//      dimensión por la que el usuario esté pasando el cursor.
// ───────────────────────────────────────────────────────────────────────

TT Titulo =
SELECTEDVALUE( Dim_OV[Modo_Entrega],
    SELECTEDVALUE( Dim_OV[Franja_Ingreso],
        SELECTEDVALUE( F_Linea_OV[Tipo_Abastecimiento],
            SELECTEDVALUE( Dim_Picking[Tamaño_Picking],
                SELECTEDVALUE( Dim_Calendario[Mes], "Total" )
            )
        )
    )
)
